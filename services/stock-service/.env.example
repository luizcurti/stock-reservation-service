# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock
DB_USER=app_user
DB_PASSWORD=change_me

# Application Configuration
NODE_ENV=development
PORT=3000

# CORS Configuration
# Comma-separated list of allowed origins. Defaults to "*" outside production,
# and to no origins (deny all) in production if unset.
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
# Max requests per IP per 15-minute window. Defaults to 100.
RATE_LIMIT_MAX=100

# Reservation expiry
# How often (ms) the running process checks for reservations past their
# expires_at and returns them to stock. Defaults to 300000 (5 minutes).
RESERVATION_CLEANUP_INTERVAL_MS=300000

# Worker processes forked via Node's cluster module (uses multiple CPU
# cores from one container). Defaults to min(CPU count, 4). Set to 1 where
# horizontal scaling already happens some other way (e.g. multiple k8s
# replicas), so pods don't fork workers that just compete for the same
# per-pod CPU limit.
WEB_CONCURRENCY=4

# How long (minutes) a reservation is held before it's eligible for
# automatic release (see Reservation expiry). Accepts fractional values
# (e.g. 0.05 = 3s) for testing. Defaults to 30 — generous slack for a
# synchronous reserve->pay->confirm flow that normally resolves in seconds,
# not a shopping-cart-style hold.
RESERVATION_TTL_MINUTES=30
