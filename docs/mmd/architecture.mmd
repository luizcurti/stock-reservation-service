        ErrorHandler["Global error handler\n(ValidateError / customError / 500)"]
    end

    Controller["ProductController\n(src/controllers)"]
    Service["ProductService\n(src/services)\nvalidation + business rules"]
    Repository["ProductRepository\n(src/repositories)\nSQL + transactions"]
    Pool["mysql2 connection pool\n(src/config/database.ts)"]
    DB[("MySQL 8.4\nIN_STOCK / RESERVED / SOLD")]

    Client --> CORS --> RateLimit --> Body --> Routes --> Controller
