{
  "name": "order-service",
  "version": "1.0.0",
  "description": "Minimal order orchestration stub — reserves stock, charges payment, confirms the sale. Exists to be a realistic synchronous HTTP host for the Istio service mesh demo, not a production order system.",
  "main": "build/index.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.21.1",
    "prom-client": "^15.1.3",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "lint": "eslint src tests --fix",
    "lint:check": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  }
}
