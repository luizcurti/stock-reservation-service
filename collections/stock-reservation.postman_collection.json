  ],
  "item": [
    {
      "name": "stock-service",
      "item": [
        {
          "name": "Create stock",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{stockUrl}}/product/{{productId}}/stock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"Collection Widget\",\n  \"qtd\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body', () => pm.expect(pm.response.json()).to.eql({ id: Number(pm.variables.get('productId')), product: 'Collection Widget', stock: 2 }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create stock \u2014 negative qtd (400)",
